  "info": {
    "forecourt": { "t": "Copper Canyon Customs", "k": "Motor Yard · custom carts and bikes", "p": "The desert's custom shop for golf carts and bikes. Roll your cart through the big door onto the turntable and press E to open the Customizer: paint and finishes, roofs, seats, wheels, stance, badges, wraps, plates and accessories. Pay with the coins you earn around Genesis." },
    "bays": { "t": "The service bays", "k": "Three lifts · tool chests · air", "p": "Three bays with two-post lifts. Every build starts here: lift kits, lowering springs, wheel swaps and the wiring for light bars and speaker bars." },
    "booth": { "t": "The paint booth", "k": "Gloss · matte · metallic · pearl · chrome", "p": "A downdraft booth with filtered air and full-length lights. Pearl and candy finishes go on in thin coats; the chrome finish is earned at Captain rank." },
    "wrap": { "t": "Wrap and decal station", "k": "Vinyl · stripes · flames · camo", "p": "Racing stripes, pinstripes, flames, tribal, lightning, camo and the desert sunset wrap, cut on the plotter and laid by hand. Plates and side labels are printed here too." },
    "wheels": { "t": "The wheel and tyre wall", "k": "Eight rim designs · five tyres", "p": "Five-spoke, mesh, turbine, chrome dish, split spoke, beadlock and wire spoke rims, in ten finishes, with street, whitewall, redline, off-road and low profile tyres." },
    "parts": { "t": "The parts wall", "k": "Light bars · coolers · speaker bars · flags", "p": "Everything that bolts on: light bars, underglow, roof racks, coolers, speaker bars, flag poles, brush guards, side steps, mud flaps, rear baskets and phone mounts." },
    "showroom": { "t": "The showroom turntable", "k": "This week's build", "p": "The shop's finished build of the week turns in the window. Every part on it is in the Customizer." },
    "lounge": { "t": "The lounge", "k": "Sofas · arcade · merch counter", "p": "Wait for your build on the sofas, play the arcade cabinet, or pick up Copper Canyon and GIVEBACK merch at the counter. The lounge looks straight at the reveal bay." }
  },
  "staff": {
    "dusty": { "name": "Dusty Navarro", "role": "Owner and master builder", "at": [20.5, -1.7], "face": 3.14159, "look": { "body": "f", "skin": "c98f63", "shirt": "22314f", "pants": "22314f", "hair": 11, "hairc": "2a1b12", "shoes": "1c1f24" },
      "greet": ["Welcome to Copper Canyon Customs.", "Roll it onto the turntable and we will make it yours."],
      "talk": [
        { "t": "Welcome to Copper Canyon. We build carts and bikes for people who like to be seen coming.", "o": [["How does it work?", 1], ["What can you do to a cart?", 2], ["Who are you?", 3]] },
        { "t": "Drive your cart, or walk in, onto the turntable in the middle of the shop and press E. The Customizer shows every option on your own cart. You only pay for what is new, and anything you already own is free to put back on.", "o": [["What do things cost?", 4], ["Thanks", -1]] },
        { "t": "Paint in thirty colours and six finishes, two-tone splits, roofs, seats, rims, tyres, a lift or a drop, badges, wraps, a plate with your name on it and a wall of accessories. Bikes get a smaller menu: frame, fenders, wheels, grips, seat, a basket and decals.", "o": [["Anything I cannot buy?", 5], ["Thanks", -1]] },
        { "t": "Dusty Navarro. I have been bending tube and laying paint in the desert since before the runway got its new lines. The crew on the floor are the best in the county.", "o": [["Back", 0], ["Thanks", -1]] },
        { "t": "Everything is paid in the coins you earn around Genesis: games, flights, stamps and time on site. The total shows before you commit, and Undo puts everything back.", "o": [["Back", 0], ["Thanks", -1]] },
        { "t": "A few pieces are earned, not bought. Pearl paint and the light bar come with Pilot rank, chrome and underglow with Captain, candy flake with Tower. Earn the rank through your Sol Passport and they are yours.", "o": [["Back", 0], ["Thanks", -1]] }
      ] }
  },
