    "lines": {
      "bays": ["That lift kit is torqued to spec. Twice.", "Hand me the half-inch, would you?", "Wheel swap done. Next.", "Who parked the shuttle in bay two again?"],
      "booth": ["Pearl goes on in four coats. Patience.", "Do not touch that, it is still tacky.", "The booth fans are loud but the finish is worth it."],
      "wrap": ["Flames always flow back. Always.", "This camo roll is the last one, order more.", "Plotter is cutting your plate now."],
      "parts": ["Light bars are back in stock.", "The coolers fit either side.", "Flag poles go on the back corner, driver side."],
      "lounge": ["Best seat in the house is facing the turntable.", "One more round on the cabinet.", "The reveal is the best part."],
      "show": ["Look at the stance on that one.", "Chrome rims and a candy finish. Wow.", "I want that one."]
    }
