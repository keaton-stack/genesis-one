{
  "version": 1,
  "streamline": true,
  "crawlStamp": "p_rs_crawl",
  "stalls": ["records", "toys", "gift", "makers", "coffee", "candy", "books", "apothecary"],
  "stallLabels": { "records": "Records and Tapes", "toys": "Rockets and Robots", "gift": "Night Market Souvenirs", "makers": "Handmade on Gantry Row", "coffee": "Late Night Coffee", "candy": "Moon Rock Sweets", "books": "Star Maps and Books", "apothecary": "Tonics and Lamps" },
  "trades": {
    "soda": { "label": "Soda fountain", "stamp": "p_rs_fountain", "role": "Soda jerk, {shop}", "keepers": ["Dolly Reyes", "Hank Ortiz", "June Calloway"],
      "greet": ["Pull up a stool!", "Float or a phosphate?", "The cherry is on the house today."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Pull up a stool: the marble counter has been here since the airfield opened, and the root beer float is still the house special.", "o": [["What's good today?", 1], ["Tell me about the place", 2], ["Thanks", null]] },
        { "t": "A chocolate malt mixed in the chrome cup, a cherry phosphate the old way, or a banana split with three sauces. Order at the register at the end of the counter.", "o": [["Sounds good", null]] },
        { "t": "Pilots waiting out the weather used to sit right where you're standing. The fountain head and the syrup pumps are the original kind; we polish them every morning.", "o": [["Nice", null]] } ],
      "venue": { "title": "Soda Fountain", "k": "Floats, malts and phosphates", "items": ["coffee", "meal"], "rename": { "coffee": ["Root beer float", "+40 energy"], "meal": ["Burger and a malt", "Energy back to 100"] } } },
    "candy": { "label": "Candy shop", "stamp": "p_rs_fountain", "role": "Candy maker, {shop}", "keepers": ["Pearl Whitfield", "Tomasito Vega", "Ivy Marsh"],
      "greet": ["Free taffy sample!", "The fudge is still warm.", "Scoop what you like."],
      "talk": [
        { "t": "Welcome to {shop}! I'm {name}. Everything in the jars is made in the back: taffy pulled on the hook, fudge on the marble slab, rock candy on strings.", "o": [["What sells best?", 1], ["Thanks", null]] },
        { "t": "Saltwater taffy, then the pick and mix. Grab a scoop at the island and I'll weigh it on the brass scale.", "o": [["Will do", null]] } ],
      "venue": { "title": "Candy Shop", "k": "Taffy, fudge and pick and mix", "items": ["coffee", "meal"], "rename": { "coffee": ["Bag of saltwater taffy", "+40 energy"], "meal": ["Fudge and a phosphate", "Energy back to 100"] } } },
    "coffee": { "label": "Coffee", "stamp": "p_rs_coffee", "role": "Roaster and barista, {shop}", "keepers": ["Marisol Pena", "Owen Hartley", "Bea Navarro", "Cal Brennan"],
      "greet": ["Fresh roast this morning.", "Espresso or pour-over?", "Morning! Or whatever time it is."],
      "talk": [
        { "t": "Hey, welcome to {shop}. I'm {name}. We roast every bag on that back wall right here in the drum roaster, a few batches a day.", "o": [["What do you recommend?", 1], ["How does the roaster work?", 2], ["Thanks", null]] },
        { "t": "The Ridge roast as a pour-over if you have five minutes, a flat white if you don't. Order at the till.", "o": [["Thanks", null]] },
        { "t": "Green beans go in the hopper, tumble in the hot drum for about twelve minutes until the second crack, then drop into the cooling tray. Smell that? That's this morning's batch.", "o": [["Great", null]] } ],
      "venue": { "title": "Coffee", "k": "Roasted here", "items": ["coffee", "meal"], "rename": { "meal": ["Pastry and a pour-over", "Energy back to 100"] } } },
    "bakery": { "label": "Bakery", "stamp": "p_rs_coffee", "role": "Baker, {shop}", "keepers": ["Lupe Aranda", "Walt Dempsey"],
      "greet": ["Loaves just out of the oven.", "Try a concha.", "Mind the flour!"],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. The oven's been lit since four this morning: sourdough, conchas, pies and the cinnamon rolls that sell out by ten.", "o": [["What's fresh?", 1], ["Thanks", null]] },
        { "t": "Everything on the racks came out of that brick oven today. The pie case is the afternoon batch.", "o": [["Smells great", null]] } ],
      "venue": { "title": "Bakery", "k": "Baked this morning", "items": ["coffee", "meal"], "rename": { "coffee": ["Concha and coffee", "+40 energy"], "meal": ["Bread basket lunch", "Energy back to 100"] } } },
    "diner": { "label": "Lunch counter", "stamp": null, "role": "Cook, {shop}", "keepers": ["Rita Calderon", "Gus Pappas", "Mae Holloway", "Kenji Arai", "Esteban Ruiz", "Pat Dunn", "Lou Benton"],
      "greet": ["Order up!", "Grab a stool, I'll be right with you.", "Coffee's on the hot plate."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Counter or a booth, your pick. Everything comes off the flat top behind me.", "o": [["What's the special?", 1], ["Thanks", null]] },
        { "t": "Today's blue plate is on the board. Order at the register, I'll call your name.", "o": [["Thanks", null]] } ],
      "venue": { "title": "Lunch Counter", "k": "Off the flat top", "items": ["coffee", "meal"], "rename": { "meal": ["Blue plate special", "Energy back to 100"] } } },
    "tavern": { "label": "Tavern", "stamp": "p_rs_tavern", "role": "Barkeep, {shop}", "keepers": ["Boone Whitaker", "Della Sparks", "Ruth Ayala"],
      "greet": ["Evening, flyer.", "What'll it be?", "Piano player's on break."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. The name comes from the tie-down ropes on the old flight line: pilots tied the planes down and walked straight in here.", "o": [["What's the propeller on the wall?", 1], ["What do you pour?", 2], ["Thanks", null]] },
        { "t": "Off a biplane that ground-looped on the field in the thirties. The pilot walked away without a scratch and traded it for a tab.", "o": [["Good story", null]] },
        { "t": "Sarsaparilla on draft, ginger beer, cider from the press in the back. Supper's whatever's in the skillet.", "o": [["I'll have one", null]] } ],
      "venue": { "title": "Tavern", "k": "Sarsaparilla and supper", "items": ["coffee", "meal"], "rename": { "coffee": ["Sarsaparilla", "+40 energy"], "meal": ["Tavern supper", "Energy back to 100"] } } },
    "gift": { "label": "Gift shop", "stamp": null, "role": "Shopkeeper, {shop}", "keepers": ["Nell Ashby", "Rafa Moreno", "Kit Delgado", "Sun Park", "Abby Kern", "Joaquin Sol", "Rosa Lindqvist", "Ty Brandt"],
      "greet": ["Postcards are two for one.", "Looking for something to take home?", "The patches are new this week."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Postcards of the flight line, patches, little biplanes, jewelry from the makers down the row. Take your time.", "o": [["What's popular?", 1], ["Thanks", null]] },
        { "t": "The embroidered patches, then the caps. The planes hanging up there are for show, but ask nicely.", "o": [["Ha, thanks", null]] } ],
      "venue": { "title": "Gift Shop", "k": "Caps, patches and keepsakes", "items": ["hat_cap", "hat_trucker", "gear_shades", "gear_bandana", "gear_lanyard", "gear_tee_gb", "gear_backpack_gb"] } },
    "outfit": { "label": "Outfitters", "stamp": "p_rs_outfit", "role": "Outfitter, {shop}", "keepers": ["Wes Harlan", "Imogen Price", "Dario Fuentes", "Lena Hargrove", "Ike Sato", "Paloma Cruz", "Grant Ochoa", "Fern Wilder"],
      "greet": ["Fitting room's free.", "Jackets just came in.", "Need a hand finding a size?"],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Work shirts, denim, flight jackets, boots and hats for the desert. The fitting room is behind the curtain.", "o": [["What do you recommend?", 1], ["Thanks", null]] },
        { "t": "Out here? A good hat and a vest with pockets. The flight crew outfit is the one everybody asks about.", "o": [["Let me look", null]] } ],
      "venue": { "title": "Outfitters", "k": "Shirts, jackets, hats and outfits", "items": ["gear_tee_gb", "gear_tee_black", "gear_hoodie_gb", "gear_vest_crew", "gear_jersey_gb", "gear_scarf", "gear_bandana", "gear_watch", "outfit_flight", "outfit_ranch", "outfit_desert"] } },
    "giveback": { "label": "The Giveback shop", "stamp": "p_rs_giveback", "role": "Giveback shop host", "keepers": ["Ava Monroe"],
      "greet": ["Welcome to the Giveback shop!", "The green hoodie is the favourite.", "Every tee on the wall is ours."],
      "talk": [
        { "t": "Welcome to the {shop}. I'm {name}. Everything on these walls carries the GIVEBACK logo: tees, hoodies, caps, packs and the crew lanyard.", "o": [["What's GIVEBACK?", 1], ["What should I get?", 2], ["Thanks", null]] },
        { "t": "Giveback powers the giving here: a share of every sale on the protocol goes to verified nonprofits, automatically, and it's all recorded on chain. The shop is the fun part.", "o": [["Nice", null]] },
        { "t": "The green hoodie with the logo on the chest, and the trucker cap. You'll see them all over the Flight Line.", "o": [["Let me look", null]] } ],
      "venue": { "title": "Giveback Shop", "k": "GIVEBACK merch", "items": ["gear_tee_gb", "gear_tee_black", "gear_hoodie_gb", "gear_jersey_gb", "gear_backpack_gb", "gear_lanyard", "hat_cap", "hat_trucker"] } },
    "hats": { "label": "Hat shop", "stamp": "p_rs_outfit", "role": "Hatter, {shop}", "keepers": ["Clementine Roux", "Amos Reed"],
      "greet": ["Every hat's shaped here.", "Let me find your size.", "Steam's up if you want a crease."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Felt hats blocked and creased by hand on that bench, straw for summer, caps for the flight line.", "o": [["How do you shape a hat?", 1], ["Thanks", null]] },
        { "t": "The felt goes over a wooden block with steam, dries overnight, then I set the brim and the crease by hand. Takes a few days to do it right.", "o": [["Beautiful", null]] } ],
      "venue": { "title": "Hat Shop", "k": "Felt, straw and caps", "items": ["hat_cowboy", "hat_cap", "hat_trucker", "hat_beanie", "hat_band"] } },
    "leather": { "label": "Leather and boots", "stamp": "p_rs_outfit", "role": "Leatherworker, {shop}", "keepers": ["Silas Crane", "Marta Ybarra", "Joel Pruitt", "Hattie Moss"],
      "greet": ["Smell that leather.", "Boots resoled while you wait.", "That saddle took six weeks."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Saddles, harness, boots and belts, cut and stitched on that bench. Some of the tools are older than the airfield.", "o": [["How long does a saddle take?", 1], ["Thanks", null]] },
        { "t": "About six weeks: the tree, then the leather wet-formed over it, then the tooling and the stitching by hand. The one on the stand is spoken for.", "o": [["Wow", null]] } ],
      "venue": { "title": "Leather Goods", "k": "Ranch wear and hats", "items": ["outfit_ranch", "outfit_desert", "hat_cowboy", "gear_bandana", "gear_scarf"] } },
    "smithy": { "label": "Farrier", "stamp": "p_rs_makers", "role": "Farrier, {shop}", "keepers": ["Ezra Holt"],
      "greet": ["Mind the forge.", "Shoes for the corral horses.", "Hot iron, keep back."],
      "talk": [
        { "t": "Welcome to the {shop}. I'm {name}. I shoe the horses for the corral and the trail rides, and forge hooks and hinges for the whole street.", "o": [["Can I watch?", 1], ["Thanks", null]] },
        { "t": "Stand back of the anvil and you can watch all day. Heat it orange, shape it, quench it in the barrel. Simple and hard.", "o": [["Thanks", null]] } ] },
    "hardware": { "label": "Parts and hardware", "stamp": null, "role": "Parts counter, {shop}", "keepers": ["Mo Kowalski", "Jess Okafor", "Rollie Banks", "Tess Navarro", "Dutch Meyer", "Amira Haddad"],
      "greet": ["What are you fixing?", "If we don't have it, we'll machine it.", "Got the part number?"],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Bolts, fittings, gauges, props and the odd radial engine. If it flies or rolls on this field, we've got a part for it.", "o": [["What's the engine on the stand?", 1], ["Thanks", null]] },
        { "t": "A seven cylinder radial off an old trainer. We rebuilt it for the fly-in. It runs, but we keep it here for the customers to look at.", "o": [["Cool", null]] } ],
      "venue": { "title": "Pilot Supply", "k": "Flight gear", "items": ["gear_watch", "gear_shades", "gear_vest_crew", "outfit_flight", "hat_cap"] } },
    "mercantile": { "label": "Mercantile", "stamp": null, "role": "Storekeeper, {shop}", "keepers": ["Tomas Aguirre", "Elsie Pratt", "Henry Two Bears", "Clara Voss"],
      "greet": ["Coffee's on the stove.", "Checkers game's open.", "Ask if you can't reach it."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Flour, beans, coffee, tins, lamp oil, cloth by the yard and anything else a body might need. The ladder rolls if you want the top shelf.", "o": [["Who plays checkers here?", 1], ["Thanks", null]] },
        { "t": "The regulars, every afternoon round the stove. Sit in if you like; the board's on the barrel.", "o": [["Maybe later", null]] } ],
      "venue": { "title": "Mercantile", "k": "Dry goods and provisions", "items": ["coffee", "hat_cowboy", "gear_bandana", "gear_scarf", "outfit_ranch", "outfit_desert"] } },
    "garden": { "label": "Garden and feed", "stamp": null, "role": "Grower, {shop}", "keepers": ["Lila Fontaine", "Burt Hanley", "Rosa Quintero", "Nate Becker", "Juniper Hale", "Abe Collins", "Maya Ortega"],
      "greet": ["Watered them this morning.", "The barrel cactus are new in.", "Seeds for the community garden?"],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Desert plants that actually like it here: agave, barrel cactus, desert marigold, chiles and a few things for the shade.", "o": [["What's easy to grow?", 1], ["Thanks", null]] },
        { "t": "A barrel cactus. Sun, sand and almost no water. Bring it a compliment once a month.", "o": [["Ha, okay", null]] } ],
      "venue": { "title": "Garden Shop", "k": "Refreshments", "items": ["coffee"], "rename": { "coffee": ["Prickly pear lemonade", "+40 energy"] } } },
    "toys": { "label": "Toys and models", "stamp": null, "role": "Toymaker, {shop}", "keepers": ["Ollie Fitch", "Greta Lund"],
      "greet": ["The train's running!", "Wind it up, go on.", "Mind the kites."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Wooden planes, tin toys, kites and the little train that runs round the table all day.", "o": [["Who builds the models?", 1], ["Thanks", null]] },
        { "t": "I do, mostly, at night. Every plane hanging from the ceiling flew out of this field at some point, full size.", "o": [["Amazing", null]] } ] },
    "gallery": { "label": "Gallery", "stamp": null, "role": "Curator, {shop}", "keepers": ["Simone Achebe", "Felix Varga"],
      "greet": ["Welcome in.", "The new show opened Friday.", "Take your time."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Desert painters, photographers and the artists from the design district. Every piece is for sale for your lot.", "o": [["Tell me about the show", 1], ["Thanks", null]] },
        { "t": "Light and distance: mesas at dusk, the old airfield, a balloon over the mountains. The bench in the middle is the best seat in the house.", "o": [["I'll sit a while", null]] } ],
      "venue": { "title": "Gallery", "k": "Art for your lot", "items": ["art"] } },
    "photo": { "label": "Photo studio", "stamp": null, "role": "Photographer, {shop}", "keepers": ["Augustin Lemaire", "Dot Fairbanks", "Iris Nakamura"],
      "greet": ["Hold very still!", "Take a seat in the posing chair.", "Darkroom's occupied."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Portraits the old way: a wooden camera, a painted backdrop and a long exposure. Sit in the chair and don't blink.", "o": [["How long do I hold still?", 1], ["Thanks", null]] },
        { "t": "A few seconds in this light. In the early days it was longer; you can see it in the faces on the wall, nobody's smiling.", "o": [["Ha", null]] } ] },
    "bikes": { "label": "Bike shop", "stamp": null, "role": "Mechanic, {shop}", "keepers": ["Danny Okoro", "Sage Whitman"],
      "greet": ["Tyre pressure check?", "Cruisers are tuned up.", "Bring it in, I'll look."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Cruisers for the dirt roads, fat tyres, baskets on the front. The one in the stand is getting new bearings.", "o": [["Best bike for out here?", 1], ["Thanks", null]] },
        { "t": "A cruiser with wide tyres and a coaster brake. Dirt roads everywhere but the runway; you'll want the fat ones.", "o": [["Good tip", null]] } ] },
    "records": { "label": "Records", "stamp": "p_rs_records", "role": "Record dealer, {shop}", "keepers": ["Jules Okonkwo", "Rae Delacroix"],
      "greet": ["The booth's free.", "New crate just in.", "Ask me for anything."],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Crates of vinyl, a listening booth in the corner and a turntable that never stops.", "o": [["What's playing?", 1], ["Thanks", null]] },
        { "t": "Desert blues from a band that played the old hangar dances. Dig through the crates, the good stuff is always at the back.", "o": [["Will do", null]] } ] },
    "barber": { "label": "Barber", "stamp": "p_rs_barber", "role": "Barber, {shop}", "keepers": ["Sal Moretti", "Cass Delaney", "Big Lou Varela"],
      "greet": ["Take a seat, you're next.", "Hot towel?", "Just a trim?"],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Cuts, shaves, hot towels. Sit in a chair when you're ready, the paper's on the table if you'd rather wait.", "o": [["What's the aviator cut?", 1], ["Thanks", null]] },
        { "t": "Short back and sides so it fits under a flying helmet. Every pilot on the field gets one sooner or later.", "o": [["I'll think about it", null]] } ] },
    "makers": { "label": "Makers", "stamp": "p_rs_makers", "role": "Maker, {shop}", "keepers": ["Ines Castillo", "Theo Barnes", "Hollis Gray"],
      "greet": ["Mind the wet pots.", "Everything here's handmade.", "Want to try the wheel?"],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Pottery, weaving, leather and wood, all made by people who live in town. The wheel is going most afternoons.", "o": [["Who makes what?", 1], ["Thanks", null]] },
        { "t": "Each shelf is a different maker; their names are under the pieces. We take turns behind the counter.", "o": [["Nice", null]] } ] },
    "books": { "label": "Books and maps", "stamp": null, "role": "Bookseller, {shop}", "keepers": ["Agnes Thornbury", "Milo Cardenas"],
      "greet": ["Mind the ladder.", "The reading chairs are free.", "Looking for anything in particular?"],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. New and used books, old maps of the border country, and two very comfortable chairs.", "o": [["Any maps of the airfield?", 1], ["Thanks", null]] },
        { "t": "On the map table: the old field plan, with the first runway drawn in pencil. Look, don't fold.", "o": [["I'll take a look", null]] } ] },
    "apothecary": { "label": "Apothecary", "stamp": null, "role": "Apothecary, {shop}", "keepers": ["Dr. Ada Bellweather", "Rufus Kline", "Mina Torres", "Otis Fairweather", "Leonor Vidal"],
      "greet": ["A tonic for the heat?", "Mind the glass.", "How can I help?"],
      "talk": [
        { "t": "Welcome to {shop}. I'm {name}. Remedies, tonics, herbs and spectacles: the drawers behind me are labelled in a hand older than mine.", "o": [["What's in the big glass globes?", 1], ["Thanks", null]] },
        { "t": "Show globes. Apothecaries put them in the window so travellers could find the shop at night. Coloured glass and a lamp behind it.", "o": [["Clever", null]] } ],
      "venue": { "title": "Apothecary", "k": "Tonics", "items": ["coffee", "gear_shades"], "rename": { "coffee": ["Ginger tonic", "+40 energy"] } } },
    "office": { "label": "Frontier office", "stamp": "p_rs_heritage", "role": "Clerk, {shop}", "keepers": ["Mr. Whitcombe", "Della Ross", "Abel Cortez", "Winifred Ames", "Hugo Brandt", "Lettie Graves", "Sam Ito", "Josefina Rios"],
      "greet": ["Next window, please.", "Sign the ledger, if you would.", "Mind the bench, it's old."],
      "talk": [
        { "t": "Welcome to the {shop}. I'm {name}. Stamps, claims, tickets, telegrams: whatever this window handles, it has handled it since the town was a few tents and a well.", "o": [["What's the history here?", 1], ["Thanks", null]] },
        { "t": "This town grew up on the border, with the smelter and the railroad and then the airfield. Half the town's papers passed through windows like this one.", "o": [["Thanks", null]] } ] },
    "sheriff": { "label": "Sheriff's office", "stamp": "p_rs_heritage", "role": "Deputy, {shop}", "keepers": ["Deputy Wade Calloway"],
      "greet": ["Keep it peaceful.", "Cell's empty today.", "Read the posters."],
      "talk": [
        { "t": "Afternoon. I'm {name}. This is the old sheriff's office, kept the way it was. The cell is open, the coffee is terrible and the wanted posters are all retired.", "o": [["Who's on the posters?", 1], ["Thanks", null]] },
        { "t": "Legends mostly. Half of them were the same horse thief with a different hat.", "o": [["Ha", null]] } ] },
    "museum": { "label": "Museum", "stamp": "p_rs_heritage", "role": "Docent, {shop}", "keepers": ["Eleanor Pike", "Victor Salas", "Prudence Hale"],
      "greet": ["Welcome to the museum.", "Please stay behind the rope.", "Ask me about anything here."],
      "talk": [
        { "t": "Welcome to the {shop}. I'm {name}. The room behind the rope is set up as it would have been on Main Street a century ago. The cases have the tools and the photographs.", "o": [["How was this collected?", 1], ["Thanks", null]] },
        { "t": "Families in town lent most of it, and the photographs of the airfield came from a box in a hangar attic. Every placard has the story.", "o": [["Thank you", null]] } ] },
    "market": { "label": "Market hall", "stamp": null, "role": "Grocer, {shop}", "keepers": ["Benita Flores"],
      "greet": ["Peaches are sweet today.", "Try a chile.", "Fresh eggs this morning."],
      "talk": [
        { "t": "Welcome to the {shop}. I'm {name}. Fruit, eggs, chiles and herbs from the farms in the valley, and jam from my sister.", "o": [["What's in season?", 1], ["Thanks", null]] },
        { "t": "Chiles, always. The ristras hanging there are from last autumn's harvest.", "o": [["Thanks", null]] } ],
      "venue": { "title": "Market Hall", "k": "Fresh from the valley", "items": ["coffee", "meal"], "rename": { "coffee": ["Fresh orange juice", "+40 energy"], "meal": ["Market basket", "Energy back to 100"] } } },
    "restroom": { "label": "Park house", "stamp": null, "role": "Park keeper", "keepers": ["Walter Pell"], "greet": ["All clean!", "Enjoy the park."],
      "talk": [ { "t": "Afternoon. I'm {name}, I keep the park house. Restrooms are clean, the water fountain outside is cold, and the lost and found is behind the counter.", "o": [["Thanks", null]] } ] },
    "stall": { "label": "Gantry Row stall", "stamp": null, "role": "Vendor, {shop}", "keepers": ["Nova Reyes", "Atlas Grant", "Luna Ferreira", "Cosmo Hale", "Vega Ansari", "Orion Diaz", "Stella Moon", "Rigel Park"] }
  },
