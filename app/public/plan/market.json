  "vendors": [
    { "id": "rosa_mk", "name": "Rosa", "role": "Desert Kitchen", "shop": 0, "look": { "body": "f", "skin": "c98f63", "shirt": "f5f1e6", "pants": "1c1f24", "hair": 2, "hairc": "1c1512" },
      "greet": ["Tacos are on.", "Try the agua fresca.", "Welcome to the Market Hall."],
      "talk": [ { "t": "Welcome in. Everything on the board comes from the valley this week: squash and corn from the valley farms, beef from a ranch past the springs, tortillas pressed next door.", "o": [["What do you recommend?", 1], ["Who built this hall?", 2], ["Just looking, thanks", null]] },
                { "t": "The bowls. Grains, charred corn, black beans, green chile and a spoon of crema. Grab a coffee at Copper Kettle and take it up to the terrace.", "o": [["Thanks", null]] },
                { "t": "It is part of the Solport Convention Center. Glass roof on timber ribs, two levels of stalls and terraces, and the weekend market out front. On summit days the whole hall fills up.", "o": [["Good to know", null]] } ] },
    { "id": "eli_mk", "name": "Eli", "role": "Copper Kettle Coffee", "shop": 3, "look": { "body": "m", "skin": "e8c19a", "shirt": "2a7a3e", "pants": "2b3a4a", "hair": 1, "hairc": "3a2416" },
      "greet": ["Coffee's fresh.", "Cortado?", "Beans roasted this week."],
      "talk": [ { "t": "Morning. We roast right here in the high desert, small batches. Espresso, a horchata latte, or the cold brew if the sun is already on the glass?", "o": [["A coffee, please", 1], ["What is the terrace like?", 2], ["Nothing for now", null]] },
                { "t": "Coming right up. Press E at the counter any time and I will pour you one.", "o": [["Thanks", null]] },
                { "t": "Best seat in the house. You look straight down the hall to the mountains through the end glass. Take the stairs by the planters.", "o": [["Will do", null]] } ] },
    { "id": "mara_mk", "name": "Mara", "role": "Native Hands", "shop": 2, "look": { "body": "f", "skin": "a86f46", "shirt": "c0462d", "pants": "3a3d42", "hair": 1, "hairc": "1c1512" },
      "greet": ["Every piece is handmade.", "Feel the weave.", "Hello there."],
      "talk": [ { "t": "Everything here is made by hand in the borderlands: coiled baskets, wool weavings, pots fired with local clay. The makers come in on market weekends to demonstrate.", "o": [["Who are the makers?", 1], ["Lovely, thank you", null]] },
                { "t": "Families from town, from the old mining town up the road and from across the line, some of them three generations at the same loom. Ask for a demonstration on Saturday.", "o": [["I will", null]] } ] },
    { "id": "tomas_mk", "name": "Tomas", "role": "Weekend Market", "stall": 0, "look": { "body": "m", "skin": "8d5a3b", "shirt": "d8c39a", "pants": "6d5a3e", "hair": 0 },
      "greet": ["Fresh from the valley.", "Melons are sweet this week.", "Pecans, roasted today."],
      "talk": [ { "t": "The weekend market runs Saturday and Sunday out front of the hall. Growers from the valley, potters, weavers, coffee, and the Giveback stand at the end of the row.", "o": [["What is at the Giveback stand?", 1], ["Thanks", null]] },
                { "t": "Tees, caps and packs, and they run the food drive with Awake.org. Bring a can, take a sticker.", "o": [["Nice", null]] } ] }
  ],
  "busker": { "x": -300, "z": 27, "name": "Busker", "line": "A guitarist plays by the planters. Press E to cheer." },
  "info": {
    "hall": ["The Market Hall", "Solport Convention Center", "A glass galleria on arched glulam timber ribs: two levels of food stalls, artisans and restaurant terraces under one roof, opening north onto the weekend market and the festival grounds. Copper and sandstone shopfronts, travertine floors, clay planters of agave, ocotillo and desert grasses. Take the stairs to the mezzanine for the terraces."],
    "west": ["The west end", "Market Hall", "The end glass looks west down the valley to the mountains. The main doors on the axis lead out to the arena side of the campus."],
    "east": ["The east end", "Market Hall", "The east doors face the Flight Line Link and the walk to the Stellar Aviation FBO."],
    "stalls": ["The Weekend Market", "Solport Convention Center", "An open air row of canopy stalls in front of the Market Hall: produce from the valley, crafts, pottery, textiles, flowers, coffee and the Giveback merch stand. String lights come on at dusk."],
    "mezz": ["The mezzanine terraces", "Market Hall", "Restaurant terraces run the length of the hall on both sides, with planters along the railings and the glass roof overhead. Sit at any table with E."],
    "busker": ["The Busker Corner", "Market Hall", "Local musicians play here on market days. Press E to cheer them on."]
  },
  "prompts": { "coffee": "buy a coffee", "snack": "order from the stall", "merch": "browse the Giveback stand", "cart": "buy a coffee at the stall", "busker": "cheer for the busker", "kiosk": "about the kiosk" },
  "lines": {
    "food": ["Order up!", "Fresh tortillas, still warm.", "Try the green chile.", "Two bowls, coming up.", "Agua fresca, watermelon today."],
    "artisan": ["Handmade up the road.", "Each one is one of a kind.", "Fired in a wood kiln.", "Feel that weave."],
    "goods": ["Mesquite honey, try a taste.", "Smoked chile, fresh ground.", "Picked this morning."],
    "coffee": ["Cortado for Sam!", "Fresh pot of cold brew.", "Oat or whole milk?"],
    "sweets": ["Conchas out of the oven.", "Prickly pear, our best seller.", "Paletas, three flavours today."],
    "stall": ["Melons, sweet as sugar!", "Pecans, roasted today.", "Pottery, all handmade.", "Bring a can for the food drive."]
  },
  "roam": {
    "names": ["Iris", "Diego", "June", "Felix", "Carmen", "Reza", "Talia", "Hugo", "Beatriz", "Noah"],
    "lines": {
      "order": ["Two of the green chile tamales, please.", "Could I get a cortado?", "What's the special today?", "Agua fresca, the watermelon one."],
      "browse": ["Is this one handmade?", "Look at the glaze on this bowl.", "I need a basket like this.", "These textiles are beautiful."],
      "stall": ["Those melons smell amazing.", "Grab some pecans for later?", "The pottery stall is my favourite.", "Let's drop a can at the food drive."],
      "dine": ["This view of the vault never gets old.", "Save room for the conchas.", "Best patio in the hall.", "Another round of coffee?"],
      "mezz": ["You can see the whole nave from up here.", "Look at those timber ribs.", "The globes are coming on."],
      "kiosk": ["JetFinders flies out of the Stellar FBO.", "Awake.org has a stand here too."],
      "busker": ["He's really good.", "Play another one!"],
      "nave": ["Meet you by the big agave.", "Did you catch the keynote?", "The Night Market starts at nine.", "I'm heading to the festival lawn after this."],
      "hello": ["Hi there.", "Enjoying the market?", "Try the green chile at Desert Kitchen.", "The terraces upstairs have the best view."],
      "any": ["What a place.", "Let's do one more lap."]
    }
