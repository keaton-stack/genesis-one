{
  // Production deploy to Giveback Ventures' own Cloudflare account (Oct 2026), alongside the Higgsfield site.
  // Build first into dist_cf (BUILD_OUT=dist_cf bun run scripts/build.mjs after check:logic and tsc), then:
  //   node node_modules/wrangler/bin/wrangler.js deploy --config wrangler.cloudflare.jsonc
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genesis-one",
  "main": "dist_cf/worker/index.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": {
    "directory": "./dist_cf/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "vars": { "HF_ENV": "production", "APP_SLUG": "genesis-one" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
